# Core
EKOKOD_ENV=development
EKOKOD_LOG_LEVEL=debug
EKOKOD_LOG_FORMAT=text
EKOKOD_TIMEZONE=Europe/Istanbul
EKOKOD_DEFAULT_LOCALE=tr

# HTTP
EKOKOD_HTTP_ADDR=:8080
EKOKOD_PUBLIC_URL=http://localhost:3000
EKOKOD_CORS_ORIGINS=http://localhost:3000
# EKOKOD_TRUSTED_PROXIES=
EKOKOD_RATE_LIMIT_API=120/min
EKOKOD_RATE_LIMIT_AUTH=5/15min

# Database
EKOKOD_DB_URL=postgres://ekokod:ekokod@postgres:5432/ekokod?sslmode=disable
EKOKOD_DB_MAX_CONNS=25
EKOKOD_DB_MIN_CONNS=5
# EKOKOD_DB_MAX_CONN_LIFETIME=1h
# EKOKOD_DB_STATEMENT_TIMEOUT=30s
# EKOKOD_READING_RETENTION=
# EKOKOD_COMPRESSION_AFTER=90d

# Redis
EKOKOD_REDIS_URL=redis://redis:6379/0
EKOKOD_REDIS_CACHE_DB=0
EKOKOD_REDIS_QUEUE_DB=1

# Security — replace every value below before any non-development use
EKOKOD_ENCRYPTION_KEY=<base64 of 32 random bytes>
EKOKOD_JWT_SIGNING_KEY=<random string, at least 32 characters>
EKOKOD_PASSWORD_PEPPER=<random string, at least 32 characters>
EKOKOD_DEVICE_FINGERPRINT_SECRET=<random string, at least 32 characters>
# EKOKOD_ACCESS_TOKEN_TTL=15m
# EKOKOD_REFRESH_TOKEN_TTL=24h
# EKOKOD_BCRYPT_COST=12
# EKOKOD_PASSWORD_HISTORY_SIZE=5
# EKOKOD_LEGACY_ENCRYPTION_KEY=<migration only: the legacy ENCRYPTION_SECRET_KEY>

# Workers and scheduler
# EKOKOD_WORKER_CONCURRENCY=10
# EKOKOD_JOB_MAX_RETRIES=5
# EKOKOD_JOB_TIMEOUT=30m
# EKOKOD_SCHEDULER_ENABLED=true
# EKOKOD_SCHEDULE_INGESTION=0 3 * * *
# EKOKOD_SCHEDULE_EPIAS=0 14 * * *
# EKOKOD_SCHEDULE_ALARMS=0 * * * *
# EKOKOD_SCHEDULE_BILLING=0 5 * * *
# EKOKOD_SCHEDULE_FORECAST=0 4 * * *
# EKOKOD_SCHEDULE_CARBON=30 4 * * *
# EKOKOD_SCHEDULE_REPORTS_MONTHLY=0 6 2 * *
# EKOKOD_SCHEDULE_REPORTS_YEARLY=0 7 3 1 *

# Storage
EKOKOD_STORAGE_ROOT=/var/lib/ekokod
# EKOKOD_UPLOAD_MAX_BYTES=31457280
# EKOKOD_UPLOAD_ALLOWED_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,text/csv,image/png,image/jpeg

# External services
EKOKOD_EPIAS_USERNAME=<epias username>
EKOKOD_EPIAS_PASSWORD=<epias password>
EKOKOD_ML_URL=http://ml:8000
EKOKOD_ML_API_KEY=<shared secret with the ML service>
# EKOKOD_ML_TIMEOUT=60s
# EKOKOD_WEATHER_PROVIDER=
# EKOKOD_WEATHER_API_KEY=<required when EKOKOD_WEATHER_PROVIDER is set>
# EKOKOD_MAP_TILE_URL=
# EKOKOD_ISOLAR_REDIRECT_URL=
# EKOKOD_PINNED_CERTS=

# Feature flags
# EKOKOD_FEATURE_SELF_REGISTRATION=false
# EKOKOD_FEATURE_PRICING_PAGE=false
# EKOKOD_FEATURE_SMS_ALARMS=false
# EKOKOD_FEATURE_ANALYTICS=false
# EKOKOD_FEATURE_TRACING=false
