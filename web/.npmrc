# This repo can be checked out on a Windows drive mounted into WSL
# (DrvFs/9p), which does not support chmod — pnpm's default hardlink-from-
# store linking depends on it and fails there. `copy` avoids chmod calls at
# the cost of some install speed; it is a no-op everywhere else (native
# Linux, macOS, CI, and inside the Docker build, which all support chmod
# fine).
package-import-method=copy
